<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ヘッダー: もちもちと吹き出し -->
        <com.mochimate.maid.MochiView
            android:id="@+id/preview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/hello"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <!-- 呼び方 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="あなたの呼び方"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ご主人様"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="12"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- お世話の種類 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="どんなお世話をしてほしい？"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="いまはおしゃべりだけ。順番に使えるようになります"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/careWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="☀️ 天気を教えてほしい（準備中）"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/careCalorie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍙 カロリーを管理してほしい（準備中）"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/careMoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 家計簿をつけてほしい（準備中）"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 権限 -->
        <LinearLayout
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ホーム画面に出るための許可"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="設定画面が開くので、「もちもちメイド」を探して「他のアプリの上に重ねて表示」をオンにして戻ってきてね。"
                android:textColor="@color/ink_sub"
                android:textSize="14sp" />

            <Button
                android:id="@+id/grant"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_sub_bg"
                android:text="許可しにいく"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/button_bg"
            android:text="ホーム画面に呼ぶ"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.3"
            android:text="使いかた\n・タップ … おしゃべり\n・ドラッグ … 好きな場所に移動\n・長押し … この画面を開く\n・通知の「おやすみさせる」… しまう"
            android:textColor="@color/ink_sub"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
