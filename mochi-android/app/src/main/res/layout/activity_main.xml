<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="96dp">

        <!-- ヘッダー: もちもちと吹き出し -->
        <com.mochimate.maid.MochiView
            android:id="@+id/preview"
            android:layout_width="120dp"
            android:layout_height="153dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hello"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            android:gravity="center"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <!-- 呼び方 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="あなたの呼び方"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ご主人様"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="12"
                android:textColor="@color/ink"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- うごき -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="うごき"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/drift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="🎈 勝手にふわふわ動き回る"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <CheckBox
                android:id="@+id/lockMaid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔒 ロック画面を見た時にも出てくる"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/lockDiag"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/button_sub_bg"
                android:text="ロック画面の記録を見る"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- おうち -->
        <LinearLayout
            android:id="@+id/homeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp" />

        <!-- お世話の種類 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="どんなお世話をしてほしい？"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="選んだお世話のことを、タップした時に話してくれます"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/careWeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="☀️ 天気を教えてほしい"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/weatherBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/currentCity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink_sub"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/cityQuery"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="街の名前（例: 横浜）"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/citySearch"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_sub_bg"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="さがす"
                        android:textColor="@color/accent"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cityResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/careCalorie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍙 カロリーを管理してほしい"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/openCalorie"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/button_sub_bg"
                android:text="健康管理をひらく"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/careMoney"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 家計簿をつけてほしい"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <Button
                android:id="@+id/openMoney"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="32dp"
                android:background="@drawable/button_sub_bg"
                android:text="家計簿をひらく"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 連携 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ほかのアプリと連携"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="通知のお知らせ・支払いの自動記録・電池のお知らせ"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />

            <Button
                android:id="@+id/openIntegration"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_sub_bg"
                android:text="連携の設定"
                android:textColor="@color/accent"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 権限 -->
        <LinearLayout
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ホーム画面に出るための許可"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="設定画面が開くので、「もちもちメイド」を探して「他のアプリの上に重ねて表示」をオンにして戻ってきてね。"
                android:textColor="@color/ink_sub"
                android:textSize="14sp" />

            <Button
                android:id="@+id/grant"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_sub_bg"
                android:text="許可しにいく"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/button_bg"
            android:text="ホーム画面に呼ぶ"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.3"
            android:text="使いかた\n・タップ … おしゃべり\n・ドラッグ … 好きな場所に移動\n・長押し … この画面を開く\n・通知の「おやすみさせる」… しまう"
            android:textColor="@color/ink_sub"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
