<?xml version="1.0" encoding="utf-8"?>
<!-- アプリの外枠: 上のタイトル・タブの中身・下のタブ・右下の呼び鈴・記録メニュー -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shell"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tabTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="もちもちメイド"
            android:textColor="@color/ink"
            android:textSize="19sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/tabContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/nav_bg"
            android:elevation="8dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 記録メニューを出している時の暗い背景 -->
    <View
        android:id="@+id/dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59281E2D"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/recordSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="84dp"
        android:background="@drawable/card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone" />

    <!-- 呼び鈴: メイドさんを呼んで記録をたのむ -->
    <LinearLayout
        android:id="@+id/bellBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/bell"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/bell_bg"
            android:contentDescription="呼び鈴で記録をたのむ"
            android:gravity="center"
            android:text="🛎️"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/bellLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="記録"
            android:textColor="@color/navy"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
