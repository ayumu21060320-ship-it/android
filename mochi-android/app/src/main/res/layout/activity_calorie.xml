<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ヘッダー -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.mochimate.maid.MochiView
                android:id="@+id/mochi"
                android:layout_width="64dp"
                android:layout_height="82dp" />

            <TextView
                android:id="@+id/say"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/ink"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 今日のまとめ(リングと PFC) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/dateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_sub"
                android:textSize="14sp" />

            <com.mochimate.maid.RingView
                android:id="@+id/ring"
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:id="@+id/pfc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- 今日の点数 -->
        <LinearLayout
            android:id="@+id/scoreCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp" />

        <!-- 体重 -->
        <LinearLayout
            android:id="@+id/weightCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp" />

        <!-- 朝・昼・夜・間食 -->
        <LinearLayout
            android:id="@+id/meals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 体のデータ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目標カロリーの計算"
                android:textColor="@color/ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/sex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="男性"
                    android:textColor="@color/ink" />

                <RadioButton
                    android:id="@+id/female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="女性"
                    android:textColor="@color/ink" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/age"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="年齢"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:textColor="@color/ink" />

                <EditText
                    android:id="@+id/height"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="身長cm"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="5"
                    android:textColor="@color/ink" />

                <EditText
                    android:id="@+id/weight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:hint="体重kg"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLength="5"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="ふだんの動き"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/activity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/actLow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="あまり動かない" android:textColor="@color/ink" android:textSize="13sp" />
                <RadioButton android:id="@+id/actMid" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ふつう" android:textColor="@color/ink" android:textSize="13sp" />
                <RadioButton android:id="@+id/actHigh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="よく動く" android:textColor="@color/ink" android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="体重は…"
                android:textColor="@color/ink_sub"
                android:textSize="13sp" />

            <RadioGroup
                android:id="@+id/plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton android:id="@+id/planLose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="減らしたい" android:textColor="@color/ink" android:textSize="13sp" />
                <RadioButton android:id="@+id/planKeep" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="キープ" android:textColor="@color/ink" android:textSize="13sp" />
                <RadioButton android:id="@+id/planGain" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="増やしたい" android:textColor="@color/ink" android:textSize="13sp" />
            </RadioGroup>

            <TextView
                android:id="@+id/goalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/ink_sub"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
